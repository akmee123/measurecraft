# Copy this file to .env and fill in the values you need.
# Nothing here is a live credential — replace every placeholder.

# --- Core app -----------------------------------------------------------
PORT=3000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Optional: require this header (X-MC-Token) on the main API. Leave unset
# for open access during local dev.
MC_API_TOKEN=
MC_AI_RATE_LIMIT=20
# Optional: password required to switch between Simple/Pro mode, if used.
MODE_SWITCH_PASSWORD=

# --- Google sign-in / sheets ---------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=

# --- Research data collection ---------------------------------------------
# Required in production to protect /research/dashboard.html and the
# research export/delete endpoints.
RESEARCH_ADMIN_TOKEN=
# Local fallback storage location (used when RESEARCH_STORAGE=s3 is not
# set, or as the local cache when it is). Defaults to ./data if unset.
RESEARCH_DATA_DIR=

# --- Research S3 mirror (optional, recommended for Render's free/ephemeral
# filesystem) -----------------------------------------------------------
# Set to "s3" to enable mirroring drawings + JSONL to a private bucket and
# hydrating the local cache from it at startup.
RESEARCH_STORAGE=
RESEARCH_S3_BUCKET=
# Use "auto" for providers (e.g. Cloudflare R2) that don't need a real AWS
# region.
RESEARCH_S3_REGION=auto
# Only needed for S3-compatible providers other than AWS (Cloudflare R2,
# Backblaze B2, MinIO, etc). Leave unset for real AWS S3.
RESEARCH_S3_ENDPOINT=
RESEARCH_S3_PREFIX=measurecraft-research
# Set to "true" only if your provider requires path-style URLs
# (bucket.example.com/bucket vs bucket.example.com), e.g. MinIO.
RESEARCH_S3_FORCE_PATH_STYLE=

# Bucket credentials. Not needed if running on infrastructure with an
# ambient IAM role (e.g. an EC2/ECS instance role) that already has
# read/write access to the bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
